{
  "manifest_version": 3,
  "name": "Classroom++",
  "short_name": "Classroom++",
  "version": "1.1.1",
  "description": "Scrollable 5-post topic windows, a hover post mover and bulk select on the Google Classroom To review page.",
  "minimum_chrome_version": "116",
  "author": "Jonathan Kung",
  "homepage_url": "https://github.com/jcykung/classroomplusplus",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://classroom.google.com/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Classroom++",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
